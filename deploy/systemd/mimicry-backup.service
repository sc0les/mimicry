[Unit]
Description=Mimicry encrypted offsite state backup
After=network-online.target

[Service]
Type=oneshot
User=mimicry
WorkingDirectory=/opt/mimicry
EnvironmentFile=/opt/mimicry/secrets.env
ExecStart=/opt/mimicry/run_backup.sh
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/mimicry /tmp
StandardOutput=journal
StandardError=journal
