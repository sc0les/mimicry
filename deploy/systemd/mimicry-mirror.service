[Unit]
Description=Mimicry IBKR mirror and immediate reconciliation
After=mimicry-gateway.service network-online.target
Wants=mimicry-gateway.service network-online.target

[Service]
Type=oneshot
User=mimicry
WorkingDirectory=/opt/mimicry
EnvironmentFile=/opt/mimicry/secrets.env
ExecStart=/opt/mimicry/run_mirror_ibkr_execute.sh
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/mimicry /tmp
StandardOutput=journal
StandardError=journal
