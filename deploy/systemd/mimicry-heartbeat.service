[Unit]
Description=Mimicry daily heartbeat
After=mimicry-reconcile.service

[Service]
Type=oneshot
User=mimicry
WorkingDirectory=/opt/mimicry
EnvironmentFile=/opt/mimicry/secrets.env
ExecStart=/opt/mimicry/run_daily_summary.sh
TimeoutStartSec=20min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/mimicry /tmp
StandardOutput=journal
StandardError=journal
