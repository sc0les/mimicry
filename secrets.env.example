# Copy this file to secrets.env and fill in your values.
# Never commit secrets.env to version control.

# Alpaca paper trading credentials
# Get at: https://alpaca.markets → Paper Trading → API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Gmail App Password for IMAP OTP polling
# Enable 2FA on your Google account, then create an App Password:
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# Portfolio tracker login credentials
TRACKER_EMAIL=                  # Gmail address used to log in to the tracker
TRACKER_LOGIN_URL=              # URL of the tracker's sign-in page
TRACKER_OTP_SENDER=             # Email address that sends OTP codes

# Portfolio tracker API
TRACKER_BASE_URL=               # Base URL of the tracker (no trailing slash)
TRACKER_API_KEY=                # x-api-key header value for the holdings API
PORTFOLIO_SLUG=                 # Portfolio identifier used in the API path
